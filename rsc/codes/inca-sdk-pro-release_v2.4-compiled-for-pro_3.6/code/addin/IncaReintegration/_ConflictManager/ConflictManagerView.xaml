<UserControl x:Class="IncaReintegration.ConflictManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"			 
             xmlns:ui="clr-namespace:IncaReintegration"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=ui.ConflictManagerViewModel}" d:DesignWidth="400" Height="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">

        <!-- STRUCTURE PRINCIPALE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Bandeaux -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
            <RowDefinition Height="Auto"/>
            <!-- Texte -->
            <RowDefinition Height="*"/>
            <!-- Tableau -->
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- 1️⃣ FILTRES / BANDEAUX -->
        <!-- ========================= -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ligne titre -->
            <TextBlock Text="{Binding TotalConflict}"
                   Grid.ColumnSpan="3"
                   Margin="0,0,0,10"/>

            <!-- Sous-grille pour alignement vertical -->
            <Grid Grid.ColumnSpan="3" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TABLE -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ChooseClass}"/>
                    <ComboBox ItemsSource="{Binding Tables}"                          
                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToResolve}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DropDownOpened">
                                <i:InvokeCommandAction Command="{Binding CmdFillWithTable}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>

                <!-- OBJECTID -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ChooseObjectid}"/>
                    <ComboBox ItemsSource="{Binding Objectids}"
                          SelectedItem="{Binding SelectedObjectid, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToResolve}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DropDownOpened">
                                <i:InvokeCommandAction Command="{Binding CmdFillWithObjectid}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>

                <!-- RESOLUTION -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding ChooseResolution}"/>
                    <ComboBox ItemsSource="{Binding Resolutions}"
                          SelectedItem="{Binding SelectedResolution, Mode=TwoWay}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DropDownOpened">
                                <i:InvokeCommandAction Command="{Binding CmdFillWithResolution}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================= -->
        <!-- 2️) BOUTONS ZOOM + BRIGHT -->
        <!-- ========================= -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="{Binding ZoomButtonTxt}"
                Command="{Binding ZoomCommand}"
                Grid.Column="0"
                Margin="0,0,10,0"/>

            <Button Content="{Binding BrightButtonTxt}"
                Command="{Binding FlashCommand}"
                Grid.Column="1"/>
        </Grid>

        <!-- ========================= -->
        <!-- 3) BOUTON SAVE -->
        <!-- ========================= -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="{Binding SaveResolutionTxt}"
                Command="{Binding SaveCommand}"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Margin="0,0,10,10"/>
        </Grid>

        <!-- ========================= -->
        <!-- 3) BOUTON SAVE DEFINITIF-->
        <!-- ========================= -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="{Binding FinalSaveTxt}"
                Command="{Binding FinalSaveCommand}"
                Grid.Column="0"
                HorizontalAlignment="Left"
                Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Left" Text="{Binding ProgressionText}"/>
        </Grid>
        
        

        <!-- ========================= -->
        <!-- 3) TEXTE TYPE CONFLIT -->
        <!-- ========================= -->
        <Grid Grid.Row="4" Margin="0,0,0,10"
              Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Ligne titre -->
            <TextBlock Text="{Binding ConflictType}"/>  
        </Grid>

        <!-- ========================= -->
        <!-- 4) TABLEAU -->
        <!-- ========================= -->
        <DataGrid Grid.Row="5"
              ItemsSource="{Binding ComparisonRows}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Champ comparé" Binding="{Binding FieldName}" Width="*" />
                <DataGridTextColumn Header="Version gdb locale" Binding="{Binding Value1}" Width="*" />
                <DataGridTextColumn Header="Version sde" Binding="{Binding Value2}" Width="*" />
                <DataGridTextColumn Header="Version initiale" Binding="{Binding Value3}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>