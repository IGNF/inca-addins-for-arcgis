<UserControl x:Class="IncaDisplay.QueueEditionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=IncaDisplay.QueueEditionViewModel}" d:DesignWidth="235" Height="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Down" Command="{Binding CmdWorkEnd}"/>
        <KeyBinding Key="Up" Command="{Binding CmdWorkStart}"/>
        <KeyBinding Key="Left" Command="{Binding CmdWorkBack}"/>
        <KeyBinding Key="Right" Command="{Binding CmdWorkNext}"/>
        <KeyBinding Key="Del" Command="{Binding CmdWorkDeleteObj}"/>
    </UserControl.InputBindings>
    <Grid>
        <Grid  Width="215" HorizontalAlignment="Center" Margin="10,10,10,11" Grid.Row="1">

            <!--#region TABLES-->
            <Button Content= "{Binding FillWithSelection}"
                    Height="25" Width="199" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="8,0"
                    Command="{Binding CmdFillWithSelection}">
            </Button>

            <TextBlock Text="{Binding FillWithTable}" 
                       Height="23" Width="197" HorizontalAlignment="Left" VerticalAlignment="Top" 
                       Margin="11,40,0,0"/>

            <ComboBox ItemsSource="{Binding Tables}" 
                      SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                      Height="22" Width="199" VerticalAlignment="Top" HorizontalAlignment="Center" 
                      Margin="0,62,0,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="DropDownOpened">
                        <i:InvokeCommandAction Command="{Binding CmdFillWithTable}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <!--#endregion-->

            <!--#region Tableau central - navigation -->
            <Grid HorizontalAlignment="Center" Height="102" Margin="0,92,0,0" VerticalAlignment="Top" Width="200">
                <!--#region BOUTON DELETE-->
                <Button Command="{Binding CmdWorkDeleteObj}" 
                        BorderBrush="OrangeRed" BorderThickness="1"
                        Height="30" Width="82" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid ToolTip="{Binding TT_DeleteObj}">
                        <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericDeleteRed32.png"/>
                    </Grid>
                </Button>
                <!--#endregion-->

                <Grid HorizontalAlignment="Center" Height="56" Margin="0,43,0,0" VerticalAlignment="Top" Width="196">
                    <!-- #region Zoom/ON-->
                    <Button Command="{Binding CmdWorkOnObject}"
                        Height="25" Width="32" Margin="60,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Grid ToolTip="{Binding OnObject}">
                            <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/RepresentationMoveTool16.png"/>
                        </Grid>
                    </Button>
                    <Button Command="{Binding CmdWorkZoomOnObject}"
                            Height="25" Width="32" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="104,0,0,0">
                        <Grid ToolTip="{Binding ZoomOnObject}">
                            <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/ZoomGeneric32.png" />
                        </Grid>
                    </Button>
                    <!--#endregion-->

                    <!-- #region pour la navigation-->
                    <Button Command="{Binding CmdWorkNext}"
                            Height="24" Width="50" Margin="146,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" 
                            Content= "&gt;" ToolTip="{Binding TT_MoveNext}"/>

                    <Button Command="{Binding CmdWorkBack}"
                            Height="24"  Width="50" HorizontalAlignment="Left"  VerticalAlignment="Top"
                            Content= "&lt;" ToolTip="{Binding TT_MoveBack}"/>

                    <Button Command="{Binding CmdWorkStart}"
                            Height="25" Width="50" HorizontalAlignment="Left"  VerticalAlignment="Bottom"
                            Content= "|&lt;&lt;" ToolTip="{Binding TT_MoveStart}"/>

                    <Button Command="{Binding CmdWorkEnd}" 
                            Height="25" Width="50" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Content= " &gt;&gt;|" ToolTip="{Binding TT_MoveEnd}" Margin="0,0,1,0" />
                    <!--#endregion-->

                    <!-- #region pour le comptage -->
                    <TextBox Text="{Binding ItemID}"
                             Height="24"  Width="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="62,0,0,0" />

                    <TextBlock Text="/ " FontSize="15"
                             Height="24" Width="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                    <TextBlock Text="{Binding ItemALL}"
                            Height="24" Width="34" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="100,05,0,0"/>
                    <!--#endregion-->
                </Grid>

            </Grid>
            <!--#endregion-->

            <!--#region VIDER/ENLEVER -->
            <Grid HorizontalAlignment="Center" Margin="0,195,0,0" VerticalAlignment="Top" Width="200" Height="28">
                <Button Command="{Binding CmdWorkremoveone}"
                        Height="25" Width="111" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text= "{Binding RemoveOne}" ToolTip="{Binding TT_RemoveOne}"/>
                </Button>

                <Button Content= "{Binding RemoveAll}"
                   Height="25" Width="65" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Command="{Binding CmdWorkremoveall}" ToolTip="{Binding TT_RemoveAll}" Margin="0,0,3,0">
                </Button>
            </Grid>
            <!--#endregion-->

            <!--#region  TRI-->
            <Expander ExpandDirection="Down"  IsExpanded="False" 
                      Margin="5,234,7,0" Height="100" VerticalAlignment="Top">
                <Grid Width="200">
                    <Button HorizontalAlignment="Right" Margin="0,5,0,0" VerticalAlignment="Top"
                        Command="{Binding CmdWorkOrderBy}" Height="25" Width="32" ToolTip="{Binding OrderBy}">
                        <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericSortAscendingBars16.png" 
                               Width="16" Height="16" />
                    </Button>
                    <Button HorizontalAlignment="Right" Margin="0,5,43,0"  VerticalAlignment="Top"
                          Command="{Binding CmdWorkOrderByDescending}" Height="25" Width="32" ToolTip="{Binding OrderByDescending}">
                        <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericSortDescendingBars16.png" 
                               Width="16" Height="16" />
                    </Button>
                    <ComboBox Height="25" Width="111" ItemsSource="{Binding Choises}" 
                          SelectedItem="{Binding SelectedChoise, Mode=TwoWay}" 
                              HorizontalAlignment="Left" Margin="3,5,0,0"  VerticalAlignment="Top">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="DropDownOpened">
                                <i:InvokeCommandAction Command="{Binding CmdFillChoises}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </ComboBox>


                    <TextBlock Text="{Binding FillWithSortResult}" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" 
                               Margin="0,40,0,0"  Width="184"   Height="25"/>

                    <!--<Button   HorizontalAlignment="Left" VerticalAlignment="Top"  
                        Command="{Binding CmdWorkSortingList}" Height="25" Width="92" ToolTip="Suppr" Margin="2,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericSortAscendingBars16.png" 
                               Width="16" Height="16" Margin="2"/>
                        <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericSortDescendingBars16.png" 
                               Width="16" Height="16" Margin="2"/>
                    </StackPanel>
                </Button>-->

                    <!-- Ajoute d'autres contrôles ici -->
                </Grid>
            </Expander>
            <!--#endregion-->

        </Grid>
    </Grid>
</UserControl>