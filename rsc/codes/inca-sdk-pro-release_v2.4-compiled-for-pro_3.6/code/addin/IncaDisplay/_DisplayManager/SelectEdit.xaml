<UserControl x:Class="IncaDisplay.SelectEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=IncaDisplay.SelectEditViewModel}" Height="70" Width="270">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
          <Button  HorizontalAlignment="Left" Margin="0,0,0,-30" BorderBrush="Transparent"
                     VerticalAlignment="Center" Width="24"  Height="24" Grid.ColumnSpan="2"
                     ToolTip="{Binding SESave}" Command="{Binding CmdSave}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/SaveMetadataCSV32.png" RenderTransformOrigin="0.65,-0.313" />
            </Button>
            
            <Button  HorizontalAlignment="Left" Margin="0,0,00,30" BorderBrush="Transparent"
         VerticalAlignment="Center" Width="24"  Height="24" Grid.ColumnSpan="2"
         ToolTip="{Binding SEOpen}" Command="{Binding CmdSelectable}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/OpenList32.png" RenderTransformOrigin="0.65,-0.313" />
            </Button>

            <ComboBox ToolTip="{Binding SEVisibility}" Height="22" ItemsSource="{Binding Selecteditlist}" 
                      SelectedItem="{Binding SE_Selectable}" 
            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,00,30" Width="208" RenderTransformOrigin="0.5,0.5">                
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="DropDownOpened">
                        <i:InvokeCommandAction Command="{Binding CmdCreateList}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>               
            </ComboBox>

            <TextBox ToolTip="{Binding SESaveName}" VerticalAlignment="Center" Height="22"  Width="208" HorizontalAlignment="Center" Margin="0,0,0,-30" Text="{Binding SaveName}" Grid.Column="1" />

            <Button  HorizontalAlignment="Right" Margin="0,0,0,30" BorderBrush="Transparent"
                     VerticalAlignment="Center" Width="24"  Height="24" Grid.ColumnSpan="2"
                     ToolTip = "{Binding SERefresh}" Command="{Binding CmdRefresh}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericRefresh32.png"/>
            </Button>
            
            <Button  HorizontalAlignment="Right" Margin="0,0,0,-30" BorderBrush="Transparent"
         VerticalAlignment="Center" Width="24"  Height="24" Grid.ColumnSpan="2"
         ToolTip="{Binding SEInfo}" Command="{Binding CmdInfo}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/FolderHome32.png"/>
            </Button>
        </Grid>       
    </Grid>

</UserControl>