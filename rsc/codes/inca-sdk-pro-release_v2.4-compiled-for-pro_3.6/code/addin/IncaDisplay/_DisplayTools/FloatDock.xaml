<UserControl x:Class="IncaDisplay.FloatDockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=IncaDisplay.FloatDockViewModel}" Height="100" Width="100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Width="34" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left">
            <!-- ID : esri_mapping_selectByRectangleTool  image : SelectionSelectTool32-->
            <Button HorizontalAlignment="Left" VerticalAlignment="Bottom"  Width="32" Height="32"
                    Command="{Binding cmd1}" 
                    ToolTip="{Binding RectangleSelect}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/SelectionSelectTool32.png" />
            </Button>
        </Grid>
        <Grid Width="34" Height="34" VerticalAlignment="Top" HorizontalAlignment="Center">
            <!-- ID : esri_mapping_clearSelectionButton   image : SelectionClearSelected32-->
            <Button  HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="32" Height="32" 
                     Command="{Binding cmd2}" ToolTip="{Binding clearSelection}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/SelectionClearSelected32.png" />
            </Button>
        </Grid>
        <Grid Width="34" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right">
            <!-- ID : esri_editing_DelSelFeaturesBtn      image : GenericDeleteRed32-->
            <Button  HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="32" Height="32"
                      Command="{Binding cmd3}" ToolTip="{Binding DeleteObj}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/GenericDeleteRed32.png" />
            </Button>
        </Grid>

        <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Left">
            <!-- esri_editing_FinishSketch  image : FinishJob32-->
            <Button  HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="32" Height="32"
                     Command="{Binding cmd4}" ToolTip="{Binding FinishSketch}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/FinishJob32.png" />
            </Button>
        </Grid>

        <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!--esri_editing_EditVerticesMove        image :EditingMoveTool32    -->
            <Button  HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="32" Height="32"
                     Command="{Binding cmd5}"  ToolTip="{Binding EditVerticesMove}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/EditingMoveTool32.png" />
            </Button>
        </Grid>

        <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Right">
            <!-- esri_editing_EditVerticesModifyFeature       images :EditingEditVertices32     -->
            <Button  HorizontalAlignment="Right" VerticalAlignment="Bottom"  Width="32" Height="32"
                     Command="{Binding cmd6}" ToolTip="{Binding EditVerticesModifyFeature}">
                <Image Source="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/EditingEditVertices32.png" />
            </Button>
        </Grid>

        <Grid Width="34" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <!-- ID : IE_CastFeatures_SplitButton     image <Image Source="/IncaEditing;component/Images/CastFeaturesBtn32.png" />-->
            <Button  HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="32" Height="32" 
                     Command="{Binding cmd7}" ToolTip="{Binding CastFeatures}" >
                <Image Source="/IncaDisplay;component/Images/CastFeaturesBtn32.png" />
            </Button>
        </Grid>

        <Grid Width="34" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <!--ID_Maps_Button <Image Source="/IncaEditing;component/Images/googlemaps32Btn.png" />-->
            <Button  HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="32" Height="32"
                     Command="{Binding cmd8}"  ToolTip="{Binding MapsButton}">
                <Image Source="/IncaDisplay;component/Images/googlemaps32Btn.png" />
            </Button>
        </Grid>
        <Grid Width="34" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <!-- ID_StreetView_SplitButton image : <Image Source="/IncaEditing;component/Images/StreetView32Btn.png" />-->
            <Button  HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="32" Height="32"
                     Command="{Binding cmd9}" ToolTip="{Binding StreetView}">
                <Image Source="/IncaDisplay;component/Images/StreetView32Btn.png" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
