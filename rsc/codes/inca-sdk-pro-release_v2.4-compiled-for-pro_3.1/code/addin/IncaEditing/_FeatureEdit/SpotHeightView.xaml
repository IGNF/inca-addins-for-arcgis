<UserControl x:Class="IncaEditing.SpotHeightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=IncaEditing.SpotHeightViewModel}" Height="89" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Height="50" VerticalAlignment="Top">
            <ComboBox Height="22" Width="200" ItemsSource="{Binding SHDomain}" 
                  SelectedItem="{Binding SelectSymbo, Mode=TwoWay}" 
                  VerticalAlignment="Center" HorizontalAlignment="Center" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="DropDownOpened">
                        <i:InvokeCommandAction Command="{Binding CmdFillWithSymbo}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
        </Grid>
        <Grid  Height="50" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95*"/>
                <ColumnDefinition Width="27*"/>
                <ColumnDefinition Width="178*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Altitude}" FontSize="14" VerticalAlignment="Center"
                 HorizontalAlignment="Left" Margin="77,0,0,0" Grid.ColumnSpan="3"/>
            <TextBox Height="26" Width="60" 
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left"
                 Text="{Binding SHeight, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="47,0,0,0" Grid.Column="2"/>
        </Grid>
    </Grid>
</UserControl>