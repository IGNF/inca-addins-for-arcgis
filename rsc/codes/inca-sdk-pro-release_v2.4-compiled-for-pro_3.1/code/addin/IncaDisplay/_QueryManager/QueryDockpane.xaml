<UserControl x:Class="IncaDisplay.QueryDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=IncaDisplay.QueryDockpaneViewModel}" Height="380" Width="285">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid HorizontalAlignment="Center" Width="285">
            <Grid Margin="0,80,0,0" Height="90" VerticalAlignment="Top">
                <TextBlock Text="{Binding QueryType}"
                       Height="28" Width="86" HorizontalAlignment="Left"  VerticalAlignment="Top"
                       TextWrapping="Wrap"  Margin="4,9,0,0"/>

                <ComboBox  Margin="90,10,10,0" 
                  Height="26" Grid.Column="1" HorizontalAlignment="Stretch"  VerticalAlignment="Top" 
                           ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"  >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="DropDownOpened">
                            <i:InvokeCommandAction Command="{Binding CmdDropDownTables}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>

                <TextBlock Text="{Binding Query}"
                           Height="28" Width="86" HorizontalAlignment="Left" VerticalAlignment="Top" 
                           TextWrapping="Wrap" Margin="4,50,0,0"/>

                <ComboBox   Margin="90,51,10,0"
                        Height="26" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="TOP"
                        ItemsSource="{Binding Queries}" SelectedItem="{Binding SelectedQuery}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="DropDownOpened">
                            <i:InvokeCommandAction Command="{Binding CmdDropDownQueries}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
            </Grid>

            <Button Content="{Binding ExecuteQuery}" 
                    Height="26"  Width="126" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,170,139,0"                     
                    Command="{Binding CmdGO}" ToolTip="{Binding TT_ExecuteQuery}"/>

            <Button Content="{Binding ShowQuery}"
                    Height="26" Width="116" HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Margin="159,170,0,0"
                    Command="{Binding CmdShowQuery}" ToolTip="{Binding TT_ShowQuery}"/>

            <Button Content="{Binding CreateTableSelection}"
                    Height="27" Width="265" HorizontalAlignment="Right"  VerticalAlignment="Top" 
                    Margin="0,261,10,0"                    
                    Command="{Binding CmdWork}" ToolTip="{Binding TT_CreateTableSelection}"/>

            <Button  Command="{Binding CmdCreateGDB }"
                     Height="45" Width="126" HorizontalAlignment="Left" VerticalAlignment="Top" 
                     Margin="10,11,0,0"             
                    ToolTip="{Binding TT_CreateGDB}">
                <TextBlock Text="{Binding CreateGDB}" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>

            <Button Command="{Binding CmdImportGDB}"
                    Width="126" Height="45" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="149,11,0,0"
                    ToolTip="{Binding TT_ImportGDB}">
                <TextBlock Text="{Binding ImportGDB}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            <TextBlock Text="{Binding NameGDB}" TextAlignment="Center"
                       Width="167" Height="25"  HorizontalAlignment="Center"  VerticalAlignment="Top" 
                       Margin="0,60,0,0"/>

            <TextBlock Text="{Binding WithName}" 
                       Height="26" Width="94" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="20,216,0,0"/>

            <TextBox Text="{Binding SelectedName}" Background="WhiteSmoke"
                       Height="26"  Width="161" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,216,10,0" />

            <!--<Image Margin="104,346,101,5" Source="D:\CODES\git_sdk\inca-sdk-pro_2.2_ok\code\addin\IncaDisplay\Images\Image1.png" 
                   Stretch="None" />-->
            <TextBox x:Name="ResultTextBox"
                     Text="{Binding ResultMessage}"
                     TextWrapping="Wrap"
                     Height="71"  Width="263" 
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,298,0,0"
                     Background="{Binding TextBoxBackground}" FontWeight="{Binding TextBoxFontWeight}"
                     />
        </Grid>
    </Grid>
</UserControl>
