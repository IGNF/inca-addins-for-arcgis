<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="IncaDisplay.dll" defaultNamespace="IncaDisplay" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{fbe5aa92-b97d-4d28-97b0-e7d99f9431fd}" version="2.4" desktopVersion="3.1.41833">
    <!--"version": AddIn version (tag du code); "desktopVersion": ArcGIS Pro Target version-->
    <Name>IncaDisplay</Name>
    <Description>Addin pour la gestion des requêtes pré-enregistrées dans une table</Description>
    <Image>Images\GenericEdition32.png</Image>
    <Author>IGN-Inca</Author>
    <Company>IGN France</Company>
    <Date>05/11/2026</Date>
    <Subject></Subject>
  </AddInInfo>
  <dependencies>
    <!-- IgnMaster-->
    <dependency name="{66f854f7-1e68-45bd-8751-280c7591036e}"/>
  </dependencies>
  <modules>
    <insertModule id="IncaDisplay_Module" className="Module1" autoLoad="false" caption="Inca Affichage">
      <groups>
        <group id="IncaDisplay_Group1" caption="Affichage" keytip="Affichage">
          <splitButton refID="ID_StreetView_SplitButton"/>

          <button refID="ID_QueueEditionDockpane_ShowButton" size="large" />
          <button refID="ID_QueryDockpane_ShowButton" size="large" />
          <button refID="ID_SelectEditDockpane_ShowButton" size="large"/>
          <button refID="ID_AttributeSets_ShowButton" size="large" separator="true"/>

          <button refID="ID_ClearMaps_ShowButton" size="small" separator="true"/>
          <button refID="ID_FloatDock_ShowButton" size="small" />

          <button refID="ID_PauseDrawing_ShowButton"  size="small" separator="true"/>
          <button refID="ID_ActiveDrawing_ShowButton"  size="small"/>

          <button refID="ID_TurnONAll_ViewButton" size="small" separator="true"/>
          <button refID="ID_TurnONAll_SelectButton" size="small"/>
          <button refID="ID_TurnONAll_EditButton" size="small"/>

          <button refID="ID_TurnOFFAll_ViewButton" size="small"/>
          <button refID="ID_TurnOFFAll_SelectButton" size="small"/>
          <button refID="ID_TurnOFFAll_EditButton" size="small"/>

        </group>
      </groups>
      <controls>
        <button id="ID_QueueEditionDockpane_ShowButton" keytip="___" caption="Queue d'édition"
          className="_EditQueue.QueueEditionDockpane_ShowButton" smallImage="Images\AddInDesktop16.png"
          largeImage="Images\QueueEdition32.png">
          <tooltip heading="Queue d'édition">
            Queue d'édition <disabledText />
          </tooltip>
        </button>
        <button id="ID_QueryDockpane_ShowButton" keytip="__" caption="Gestionnaire de requêtes"
          className="_QueryManager.QueryDockpane_ShowButton" smallImage="Images\AddInDesktop16.png"
          largeImage="Images\Gestionnaire32.png">
          <tooltip heading="Gestionnaire de requêtes">
            Gestionnaire de requêtes <disabledText />
          </tooltip>
        </button>
        <button id="ID_SelectEditDockpane_ShowButton" keytip="__" caption="Gestionnaire d'affichage"
          className="_DisplayManager.SelectEditDockpane_ShowButton"
          largeImage="Images\Select_Edit_32.png">
          <tooltip heading="Gestion des affichages">
            Gestionnaire d'affichage <disabledText />
          </tooltip>
        </button>
        <button id="ID_ClearMaps_ShowButton" keytip="__" caption="Vide toutes les sélections"
          className="_DisplayTools.ClearMaps_Button"
          smallImage="Images\clear_all_maps.png">
          <tooltip heading="Vide les sélections">
            Vide les sélections de toutes les cartes <disabledText />
          </tooltip>
        </button>
        <button id="ID_FloatDock_ShowButton" keytip="___" caption="Accès rapide flottant"
          className="_DisplayTools.FloatDock_ShowButton"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/RasterFunctionColorModel16.png"
          largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/RasterFunctionColorModel32.png" >
          <tooltip heading="Boite accès rapide">
            Ouvre une boîte d’accès rapide avec quelques boutons habituels<disabledText />
          </tooltip>
        </button>
        <button id="ID_AttributeSets_ShowButton" keytip="___" caption="Jeux d'attributs"
          className="_AttributeSets.AttributeSets_ShowButton"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/EditingUpdateCOGOAttributes16.png"
          largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/EditingUpdateCOGOAttributes32.png">
          <tooltip>
            Ouvre la fenêtre des jeux d'attributs<disabledText/>
          </tooltip>
        </button>
        <button id="ID_PauseDrawing_ShowButton" keytip="__" caption="Pause de mise à jour d'affichage sur toutes les cartes" className="_DisplayTools.PauseDrawing_Button"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Pause16.png"
          largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Pause32.png">
          <tooltip heading="">
            Applique une pause dans le dessin sur toutes les cartes ouvertes<disabledText/>
          </tooltip>
        </button>
        <button id="ID_ActiveDrawing_ShowButton"   keytip="__" caption="Mise à jour d'affichage sur toutes les cartes" className="_DisplayTools.ActiveDrawing_Button"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Play16.png"
          largeImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/Play32.png">
          <tooltip heading="">
            Le bouton réactive la mise à jour du dessin sur toutes les cartes ouvertes<disabledText />
          </tooltip>
        </button>
        <button id="ID_StreetView_Button" keytip="___" caption="Google StreetView" className="_DisplayTools.CheckOnStreetView"
          loadOnClick="false" smallImage="Images\StreetView16.png" largeImage="Images\StreetView32.png">
          <tooltip heading="Navigation StreetView">
            Permet de vérifier des informations sur les données terrain de Google StreetView<disabledText />
          </tooltip>
        </button>
        <button id="ID_Maps_Button" keytip="___" caption="Google Maps Satellite" className="_DisplayTools.CheckOnMaps"
          loadOnClick="false" smallImage="Images\googlemaps16.png" largeImage="Images\googlemaps32.png">
          <tooltip heading="Cartes Satellite">
            Permet de vérifier des informations sur les données terrain de Google Maps<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnONAll_ViewButton" caption="Tout afficher" loadOnClick="true" keytip="__"
          className="_DisplayContents.TurnOnAll_ViewButton"
          smallImage="Images\TurnOnAllView16.png" largeImage="Images\TurnOnAllView32.png">
          <tooltip heading="Tout afficher">
            Coche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnOFFAll_ViewButton" caption="Tout masquer" loadOnClick="true"
          keytip="__"   className="_DisplayContents.TurnOffAll_ViewButton"
          smallImage="Images\TurnOffAllView16.png" largeImage="Images\TurnOffAllView32.png">
          <tooltip heading="Tout masquer">
            Décoche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnONAll_SelectButton" caption="Tout sélectionnable" loadOnClick="true" keytip="__"
          className="_DisplayContents.TurnOnAll_SelectButton"
          smallImage="Images\TurnOnAllSelect16.png" largeImage="Images\TurnOnAllSelect32.png">
          <tooltip heading="Tout sélectionnable">
            Coche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnOFFAll_SelectButton" caption="Rien sélectionnable" loadOnClick="true"
          keytip="__"   className="_DisplayContents.TurnOffAll_SelectButton"
          smallImage="Images\TurnOffAllSelect16.png" largeImage="Images\TurnOffAllSelect32.png">
          <tooltip heading="Rien sélectionnable">
            Décoche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnONAll_EditButton" caption="Tout éditable" loadOnClick="true" keytip="__"
          className="_DisplayContents.TurnOnAll_EditButton"
          smallImage="Images\TurnOnAllEdit16.png" largeImage="Images\TurnOnAllEdit32.png">
          <tooltip heading="Tout éditable">
            Coche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
        <button id="ID_TurnOFFAll_EditButton" caption="Rien éditable" loadOnClick="true"
          keytip="__"   className="_DisplayContents.TurnOffAll_EditButton"
          smallImage="Images\TurnOffAllEdit16.png" largeImage="Images\TurnOffAllEdit32.png">
          <tooltip heading="Rien éditable">
            Décoche toutes les couches et groupes de couches<disabledText />
          </tooltip>
        </button>
      </controls>
      <splitButtons>
        <splitButton id="ID_StreetView_SplitButton">
          <button refID="ID_StreetView_Button" />
          <button refID="ID_Maps_Button" separator="true" />
        </splitButton>
      </splitButtons>
      <menus>
        <menu id="ID_TurnONOFF_ViewMenuButton" caption="Affichage"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/ContentsWindowListByDrawingOrder24.png">
          <button refID="ID_TurnONAll_ViewButton"/>
          <button refID="ID_TurnOFFAll_ViewButton" />
        </menu>
        <menu id="ID_TurnONOFF_SelectMenuButton" caption="Sélection"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/SelectionSelectUnselect16.png">
          <button refID="ID_TurnONAll_SelectButton" />
          <button refID="ID_TurnOFFAll_SelectButton" />
        </menu>
        <menu id="ID_TurnONOFF_EditMenuButton" caption="Édition"
          smallImage="pack://application:,,,/ArcGIS.Desktop.Resources;component/Images/EditingSketchTool16.png">
          <button refID="ID_TurnONAll_EditButton" />
          <button refID="ID_TurnOFFAll_EditButton" />
        </menu>
      </menus>
      <dockPanes>
        <dockPane id="ID_QueryDockpane" caption="Gestionnaire de requête" className="_QueryManager.QueryDockpaneViewModel" height="400" width="350" dock="float" hidden="true">
          <content className="QueryDockpaneView" />
        </dockPane>
        <dockPane id="ID_QueueEditionDockpane" caption="Queue d'édition" className="_EditQueue.QueueEditionViewModel" height="350" width="300" dock="float" hidden="true">
          <content className="QueueEditionView" />
        </dockPane>
        <dockPane id="ID_SelectEditDockpane" caption="Gestionnaire d'affichage" className="_DisplayManager.SelectEditViewModel" height="100" width="300" dock="group" dockWith="esri_core_contentsDockPane" hidden="false">
          <content className="SelectEditView" />
        </dockPane>
        <dockPane id="ID_FloatDock" caption="Accès rapide" className="_DisplayTools.FloatDockViewModel" height="400" width="350" dock="float" hidden="true">
          <content className="FloatDockView" />
        </dockPane>
        <dockPane id="ID_AttributeSets" caption="Jeux d'attributs" height="70" width="270" className="_AttributeSets.AttributeSetsViewModel">
          <content className="AttributeSetsView" />
        </dockPane>
        <dockPane id="InfoButtonPane" caption="Édition d'un bouton"
          className="_AttributeSets.InfoButtonViewModel" >
          <content className="InfoButtonViewModel" />
        </dockPane>
      </dockPanes>
    </insertModule>
    <updateModule refID="IgnMaster_Module">
      <tabs>
        <updateTab refID="IgnMaster_Tab">
          <insertGroup refID="IncaDisplay_Group1" />
        </updateTab>
      </tabs>
    </updateModule>
    <updateModule refID="esri_mapping">
      <menus>
        <updateMenu refID="esri_mapping_mapContextMenu">
        <insertButton refID="ID_TurnONOFF_EditMenuButton"
          placeWith="esri_mapping_newGroupLayerButton" />
        <insertButton refID="ID_TurnONOFF_SelectMenuButton"
          placeWith="esri_mapping_newGroupLayerButton"/>
        <insertButton refID="ID_TurnONOFF_ViewMenuButton"
          placeWith="esri_mapping_newGroupLayerButton" separator="true"/>
        </updateMenu>
      </menus>
    </updateModule>
    <!-- separator="true" -->
  </modules>
</ArcGIS>