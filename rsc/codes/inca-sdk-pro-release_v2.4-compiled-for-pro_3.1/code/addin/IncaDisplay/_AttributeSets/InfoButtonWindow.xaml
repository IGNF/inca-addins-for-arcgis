<Window x:Class="IncaDisplay._AttributeSets.InfoButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IncaDisplay._AttributeSets"
        mc:Ignorable="d" Title="{Binding Editing_}"
        WindowStartupLocation="CenterOwner" Width="600" Height="500"
        ResizeMode="NoResize"
         d:DataContext="{Binding Path=IncaDisplay.AttributeSetsViewModel}">

    <DockPanel x:Name="InfoButton">
        <Grid Background="WhiteSmoke"
            Width="600" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!--  Colonne pour l'affichage des infos du bouton (nom, filtre d'attributs, ...) -->
            <Grid Grid.Row="0" Width="290" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left" Grid.ColumnSpan="2">
                 
                <Grid HorizontalAlignment="Left" Height="106" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="{Binding btnName_}"
                        Width = "120" Height = "15"
                        VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <TextBox Text="{Binding Rule.BtnName}" Margin="0,20,0,0"
                        MinWidth ="120"   Height = "25"
                        VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding btnFeature_}" Margin="0,60,0,0"
                        Width = "120" Height = "15"
                        VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <TextBox Text="{Binding Rule.BtnClassName}"  Margin="0,80,0,0"
                        MinWidth = "120" Height = "25"
                        VerticalAlignment="Top" HorizontalAlignment="Left"/>

                </Grid>
                
                <!-- Icones ini et modifiée (si) -->
                <Grid HorizontalAlignment="Right" Height="106" Width="120" VerticalAlignment="Top" Margin="0,2,2,0">
                    <!-- Image INI-->
                    <Image Source="{Binding Rule.InitialImageText}" 
                           Stretch = "Uniform" VerticalAlignment="Top"  ToolTip="initial image"
                           Width="80" Height="40" Margin="0,20,34,0"> 
                    </Image> 
                    <!-- Image si click sur une icone -->
                    <Image Source="{Binding Rule.BtnImageText}" 
                           Stretch = "Uniform"   VerticalAlignment="Top"
                           Margin="0,66,34,0"   Width="80" Height="40">
                    </Image>
                </Grid>

                <!--// ATTRIBUTS-->
                <TextBlock Text="{Binding btnAttributes_}" Margin="5,125,0,0"
                       Width = "120" Height = "15"
                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
             
                <DataGrid Margin="5,150,0,0" Height="280"
                          VerticalAlignment="Top" HorizontalAlignment="Left"  
                        ItemsSource="{Binding Fields}"
                          AutoGenerateColumns="False" CanUserAddRows="True"
                          CanUserDeleteRows="True" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code"
                            Binding="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                        <DataGridTextColumn Header="Description"
                            Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>                
            </Grid> 

            <!--GRID colonne pour l'affichage des images du dossier-->
            <Grid Grid.Row="0" Width="300" Grid.Column="1"
                  VerticalAlignment="Top" HorizontalAlignment="Right">
                
                <TextBlock Text="{Binding Icon_}" Margin="5,5,0,0"
                           Width = "120" Height = "15"
                           VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            
                <ItemsControl ItemsSource="{Binding Icons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="5,25,25,0" Height="405" Background="White"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="5" Command="{Binding DataContext.IconClickCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Image Source="{Binding ImagePath}" Width="32" Height="32" Stretch="Uniform"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!--GRID Row_CANCEL_ENTER-->
            <Grid Grid.Row="1"  VerticalAlignment="Center" Grid.ColumnSpan="2" >
                <Button Content="{Binding btnCancel_}"   Width="75" Height="25"
                      HorizontalAlignment="Right"  Margin="0,0,150,0"
                      Command="{Binding CmdCancel}"/>

                <Button Content="OK" Width="75" Height="25" 
                      HorizontalAlignment="Left" Margin="150,0,0,0"
                      Command="{Binding CmdOK}" 
                      IsCancel="True"/>
            </Grid>
            
        </Grid>
    </DockPanel>
</Window>
